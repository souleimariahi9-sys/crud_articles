{% extends 'base.html.twig' %}

{% block body %}
<h1>Ajouter un article</h1>
<form method="post">
    <label>Titre <input type="text" name="titre" required></label><br>
    <label>Contenu <textarea name="contenu" rows="5" cols="30" required></textarea></label><br>
    <label>Auteur <input type="text" name="auteur" required></label><br>
    <button type="submit">Créer</button>
    <a href="{{ path('article_index') }}">Annuler</a>
</form>
{% endblock %}