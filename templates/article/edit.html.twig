{% extends 'base.html.twig' %}

{% block body %}
<h1>Modifier un article</h1>
<form method="post">
    <label>Titre <input type="text" name="titre" value="{{ article.titre }}" required></label><br>
    <label>Contenu <textarea name="contenu" rows="5" cols="30" required>{{ article.contenu }}</textarea></label><br>
    <label>Auteur <input type="text" name="auteur" value="{{ article.auteur }}" required></label><br>
    <button type="submit">Enregistrer</button>
    <a href="{{ path('article_index') }}">Annuler</a>
</form>
{% endblock %}