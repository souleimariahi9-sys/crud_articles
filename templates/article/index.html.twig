{% extends 'base.html.twig' %}

{% block body %}
<h1>Articles</h1>
<a href="{{ path('article_add') }}">+ Nouvel article</a>

<table>
    <tr><th>ID</th><th>Titre</th><th>Auteur</th><th>Date</th><th>Actions</th></tr>
    {% for a in articles %}
    <tr>
        <td>{{ a.id }}</td>
        <td>{{ a.titre }}</td>
        <td>{{ a.auteur }}</td>
        <td>{{ a.date|date('d/m/Y') }}</td>
        <td>
            <a href="{{ path('article_show', {id: a.id}) }}">Voir</a>
            <a href="{{ path('article_edit', {id: a.id}) }}">Modifier</a>
            <a href="{{ path('article_delete', {id: a.id}) }}"
               onclick="return confirm('Supprimer cet article ?')">Supprimer</a>
        </td>
    </tr>
    {% endfor %}
</table>
{% endblock %}